        "OPENAI_API_KEY_FILE": "/run/secrets/vetorial_agent_openai",
        "VETORIAL_AGENT_SECRET_FILE": "/run/secrets/vetorial_agent_bridge",
        "CALENDAR_GATEWAY_SECRET_FILE": "/run/secrets/vetorial_agent_calendar",
        "CALENDLY_TOKEN_FILE": "/run/secrets/vetorial_agent_calendly",
        "CRM_URL": "http://evo_crm:3000",
        "OPENAI_PROJECT": "proj_zV3BAJYkfAHytv0hezQlY9DA",
        "OPENAI_MODEL": "gpt-6-luna",
        "OPENAI_ANALYST_MODEL": "gpt-6-luna",
        "VETORIAL_AGENT_INBOX_ID": "702de859-a676-4af9-a2a1-806da82785d8",
        "VETORIAL_AGENT_ALLOWLIST": "+5521973801603",
        "VETORIAL_AGENT_ALL_CONTACTS": "false",
        "VETORIAL_AGENT_ANALYSIS_ALL": "false",
        "VETORIAL_AGENT_INTERNAL_NUMBERS": "+554792548551",
